{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Extract Section",
            "type": "shell",
            "command": "python3",
            "args": [
                "/path/to/md_agent.py",
                "extract",
                "${file}",
                "${lineNumber}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Analyze Document",
            "type": "shell",
            "command": "python3",
            "args": [
                "/path/to/md_agent.py",
                "analyze",
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}